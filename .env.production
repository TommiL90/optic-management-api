# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ============================================
# IMPORTANTE: Este archivo es una plantilla.
# En producción (Dokploy), configurar estas variables en la UI de Dokploy.
# NO commitear este archivo con valores reales de producción.
# ============================================

# ============================================
# Node.js Application
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=warn
LOG_PRETTY=false

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_USER=optic_user
POSTGRES_PASSWORD=CAMBIAR_ESTE_PASSWORD_POR_UNO_SEGURO
POSTGRES_DB=optic_db

# Database URL (usado por Prisma)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=3&pool_timeout=20
# IMPORTANTE: Cambiar el password por el mismo valor de POSTGRES_PASSWORD
DATABASE_URL=postgresql://optic_user:CAMBIAR_ESTE_PASSWORD_POR_UNO_SEGURO@db:5432/optic_db?schema=public&connection_limit=3&pool_timeout=20

# ============================================
# Docker Compose (opcional)
# ============================================
API_PORT=3000
